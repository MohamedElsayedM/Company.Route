@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Index";
}

<h1>All Employees</h1>
<br />
<br />

<form class="container m-4">
    <div class="row" >
        <div class="col-10">
            <input type="text" name="SearchInput" placeholder="Search by Name" class="form-control" />
       </div>
       <div class="col-2">
            <input type="submit" value="Search" class="btn btn-success" />
       </div>
    </div>
</form>

<a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Create Employee</a>
<br />
<br />


@if(Model.Count() >0 )
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Email</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Salary</th>
                <th>IsActive</th>
                <th>IsDeleted</th>
                <th>HiringDate</th>
                <th>CreateAt</th>
                <th>Department</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <th>@item.Name</th>
                    <th>@item.Age</th>
                    <th>@item.Email</th>
                    <th>@item.Address</th>
                    <th>@item.Phone</th>
                    <th>@item.Salary</th>
                    <th>@item.IsActive</th>
                    <th>@item.IsDeleted</th>
                    <th>@item.HiringDate</th>
                    <th>@item.CreateAt</th>
                    @if (item.Department is null){
                            <th>No Department</th>
                        }else{
                            <th>@item.Department.Name</th>
                             }
  
                   <partial name="_ButtonsPartialView" model="@item.Id"/>
                </tr>
            }
            <tr></tr>
        </tbody>

    </table>


}
else
{
    <div class="alert alert-info mt-4">
        <h4> There is no Department :( </h4>
    </div>
}


