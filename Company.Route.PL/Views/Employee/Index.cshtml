@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Index";
}

<h1>All Employees</h1>

<br />
<br />

<a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Create Employee</a>
<br />
<br />


@if(Model.Count() >0 )
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Email</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Salary</th>
                <th>IsActive</th>
                <th>IsDeleted</th>
                <th>HiringDate</th>
                <th>CreateAt</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <th>@item.Name</th>
                    <th>@item.Age</th>
                    <th>@item.Email</th>
                    <th>@item.Address</th>
                    <th>@item.Phone</th>
                    <th>@item.Salary</th>
                    <th>@item.IsActive</th>
                    <th>@item.IsDeleted</th>
                    <th>@item.HiringDate</th>
                    <th>@item.CreateAt</th>
                    <th><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning">Details</a></th>
                    <th><a asp-action="Update" asp-route-id="@item.Id" class="btn btn-success">Update</a></th>
                    <th><a asp-action="delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a></th>
                </tr>
            }
            <tr></tr>
        </tbody>

    </table>


}
else
{
    <div class="alert alert-info mt-4">
        <h4> There is no Department :( </h4>
    </div>
}


