@model DepartmentDto
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Department</h1>

<br />
<br />

<form asp-action="Edit">
    <partial name="DepartmentPartialViews/CreateEditPartialView"/>
    <div class="my-4">
        <input class="btn btn-primary" value="Save" type="submit" />
        <a asp-action="Index" class="btn btn-light text-decoration-none">Back to list</a>
